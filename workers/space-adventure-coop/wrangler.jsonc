{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "space-adventure-coop",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "GameRoom", "class_name": "GameRoom" },
      { "name": "OnlineRoom", "class_name": "OnlineRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["OnlineRoom"] }
  ],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/parties/*"]
  },
  "vars": {
    "FRONTEND_ORIGINS": "https://adaptatech.org,https://www.adaptatech.org,https://deploy-preview-850--adaptatech.netlify.app"
  }
}
