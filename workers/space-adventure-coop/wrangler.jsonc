{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "space-adventure-coop",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "GameRoom", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/parties/*"]
  },
  "vars": { "FRONTEND_ORIGINS": "https://adaptatech.org,https://www.adaptatech.org" }
}
